flowchart TD
  START([Start]) --> OPEN["Open Secure Change-Password page"]
  OPEN --> S1["Step 1: enter current password"]
  S1 --> INIT["POST /password/change/init"]
  INIT --> VCUR{"Current password<br/>correct?"}
  VCUR -- No --> E1["Show error"]
  E1 --> S1
  VCUR -- Yes --> OTP["Generate OTP, email it,<br/>store hash + expiry"]
  OTP --> S2["Step 2: enter 6-digit OTP"]
  S2 --> S3["Step 3: enter new password"]
  S3 --> STR{"Strength &ge; Good<br/>&amp; confirm matches?"}
  STR -- No --> E2["Disable submit / show hints"]
  E2 --> S3
  STR -- Yes --> SUBMIT["POST /password/change<br/>(otp + newPassword)"]
  SUBMIT --> VOTP{"OTP valid,<br/>not expired,<br/>attempts left?"}
  VOTP -- No --> E3["Show error, return to Step 2"]
  E3 --> S2
  VOTP -- Yes --> UPDATE["Hash &amp; save new password<br/>revoke refresh tokens"]
  UPDATE --> MAIL["Send confirmation email<br/>with recovery reset link"]
  MAIL --> OUT["Auto-logout, redirect to Login"]
  OUT --> END([End])
