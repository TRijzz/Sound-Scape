flowchart TD
  START([Start]) --> BROWSE["Browse Vinyl Store"]
  BROWSE --> OPEN["Open a vinyl product page"]
  OPEN --> LOAD["Load vinyl details<br/>resolve tracklist (best-effort)"]
  LOAD --> AUTH{"User signed in?"}
  AUTH -- No --> PROMPT["Prompt to sign in"]
  PROMPT --> END1([End])
  AUTH -- Yes --> OWNED{"Already owns<br/>this edition?"}
  OWNED -- Yes --> COLL["Open in collection"]
  COLL --> END2([End])
  OWNED -- No --> BUY["Click Buy"]
  BUY --> INIT["Initiate Khalti payment<br/>get payment_url"]
  INIT --> REDIR["Redirect to Khalti gateway"]
  REDIR --> PAY{"Payment<br/>completed?"}
  PAY -- No --> FAIL["Show failure toast"]
  FAIL --> OPEN
  PAY -- Yes --> CALLBACK["Khalti callback to system"]
  CALLBACK --> VERIFY["Verify transaction<br/>record PaymentTransaction"]
  VERIFY --> GRANT["Add vinyl to<br/>purchased_vinyls"]
  GRANT --> CONFIRM["Show success, vinyl in Library"]
  CONFIRM --> END3([End])
